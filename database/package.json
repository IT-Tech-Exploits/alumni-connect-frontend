{
  "name": "alumni-connect-database",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Self-contained Mongoose database package for Exploits Alumni Connect. Models mirror the frontend types 1:1; data is driven from the live frontend contract.",
  "exports": {
    ".": "./db/connect.ts",
    "./models/*": "./models/*.ts",
    "./ref": "./db/ref.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "seed": "tsx seed/index.ts",
    "verify": "tsx scripts/verify.ts",
    "lint": "eslint db models seed scripts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "mongoose": "^8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
